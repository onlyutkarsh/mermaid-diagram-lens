    "editor.defaultFormatter": "biomejs.biome"
  },
  "chat.tools.terminal.autoApprove": {
    "gh": true,
    "/^cd /home/utkarsh/onlyutkarsh/mermaid-viewer && npm run compile 2>&1 \\| tail -16 && echo '--- scan extracted aqa blocks for suspicious concatenation ---' && node - <<'NODE'\nconst fs = require\\('fs'\\);\nconst MarkdownIt = require\\('markdown-it'\\);\nconst src = fs\\.readFileSync\\('examples/aqa\\.md','utf8'\\);\nconst html = new MarkdownIt\\(\\)\\.render\\(src\\);\nconst paras = \\[\\.\\.\\.html\\.matchAll\\(/<p>\\(\\[\\\\s\\\\S\\]\\*\\?\\)<\\\\/p>/g\\)\\]\\.map\\(m => m\\[1\\]\n  \\.replace\\(/&gt;/g,'>'\\)\n  \\.replace\\(/&lt;/g,'<'\\)\n  \\.replace\\(/&amp;/g,'&'\\)\n  \\.replace\\(/\\\\r/g,''\\)\\);\n\nconst blocks = \\[\\];\nfor \\(let i = 0; i < paras\\.length; i\\+\\+\\) \\{\n  const p = paras\\[i\\];\n  const singleBlock = p\\.match\\(/\\^:::\\+\\\\s\\*mermaid\\\\s\\*\\\\n\\(\\[\\\\s\\\\S\\]\\*\\?\\)\\\\n:::\\+\\\\s\\*\\$/i\\);\n  if \\(singleBlock\\) \\{ blocks\\.push\\(singleBlock\\[1\\]\\.trim\\(\\)\\); continue; \\}\n  const opener = p\\.match\\(/\\^:::\\+\\\\s\\*mermaid\\\\s\\*\\(\\?:\\\\n\\(\\[\\\\s\\\\S\\]\\*\\)\\)\\?\\$/i\\);\n  if \\(!opener\\) continue;\n  const chunks = \\[\\];\n  if \\(\\(opener\\[1\\]\\|\\|''\\)\\.trim\\(\\)\\) chunks\\.push\\(\\(opener\\[1\\]\\|\\|''\\)\\.trim\\(\\)\\);\n  let foundCloser = false;\n  let j = i\\+1;\n  while \\(j < paras\\.length\\) \\{\n    const next = paras\\[j\\];\n    const t = next\\.trim\\(\\);\n    if \\(/\\^:::\\+\\\\s\\*\\$/\\.test\\(t\\)\\) \\{ foundCloser = true; i = j; break; \\}\n    const ends = next\\.match\\(/\\^\\(\\[\\\\s\\\\S\\]\\*\\?\\)\\\\n:::\\+\\\\s\\*\\$/\\);\n    if \\(ends\\) \\{ if \\(\\(ends\\[1\\]\\|\\|''\\)\\.trim\\(\\)\\) chunks\\.push\\(\\(ends\\[1\\]\\|\\|''\\)\\.trim\\(\\)\\); foundCloser = true; i = j; break; \\}\n    chunks\\.push\\(next\\.trim\\(\\)\\);\n    j\\+\\+;\n  \\}\n  const source = chunks\\.join\\('\\\\n'\\)\\.split\\('\\\\n'\\)\\.map\\(l=>l\\.trimEnd\\(\\)\\)\\.filter\\(l=>!/\\^:::\\+\\\\s\\*\\$/\\.test\\(l\\.trim\\(\\)\\)\\)\\.join\\('\\\\n'\\)\\.trim\\(\\);\n  if \\(foundCloser && source\\) blocks\\.push\\(source\\);\n\\}\n\nconsole\\.log\\('blocks:', blocks\\.length\\);\nlet bad = 0;\nblocks\\.forEach\\(\\(b, idx\\) => \\{\n  const suspicious = /:::\\+\\\\s\\*mermaid/i\\.test\\(b\\) \\|\\| /:::\\+\\\\s\\*\\$/\\.test\\(b\\) \\|\\| b\\.includes\\(':::::'\\);\n  if \\(suspicious\\) \\{\n    bad\\+\\+;\n    console\\.log\\('BAD block', idx, b\\.slice\\(0, 180\\)\\.replace\\(/\\\\n/g, '\\\\\\\\n'\\)\\);\n  \\}\n\\}\\);\nconsole\\.log\\('suspicious blocks:', bad\\);\nNODE$/": {
      "approve": true,
      "matchCommandLine": true
    }
  },
  "github.copilot.chat.commitMessageGeneration.instructions": [
  {
    "text": "Follow the Conventional Commits specification. Format: <type>(<scope>): <subject>. Types: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert. Example: feat(auth): add OAuth2 PKCE flow support"
  },
  {
    "text": "Subject must be imperative mood, sentence case, no period, max 72 characters. Never mention file names, line numbers, or implementation details. Never use vague subjects like 'fix bug', 'update code', 'wip', or 'misc changes'."
  },
  {
    "text": "Derive scope from the primary area changed: e.g. api, ui, db, auth, infra, config, messaging, pipeline. Omit scope only for cross-cutting changes."
  },
  {
    "text": "Include a body for non-trivial changes, separated from the subject by a blank line, wrapped at 72 characters. The body must explain WHY — the business or technical motivation — not WHAT (the diff shows that). If the reason cannot be inferred from the diff or context, write a placeholder: '# why: <fill in reason>' so the author is prompted before committing."
  },
  {
    "text": "If the change closes a work item, append a footer: Closes #<id> or Refs #<id>. For breaking changes, add BREAKING CHANGE: <description> in the footer."
  },
  {
    "text": "If multiple logical changes are staged, prefer splitting into separate commits. If they must be combined, list each change as a bullet in the body."
  }
],
  "[jsonc]": {
    "editor.defaultFormatter": "biomejs.biome"
  }
}